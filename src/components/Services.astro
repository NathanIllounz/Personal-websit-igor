---
import Section from './Section.astro';
import type { Site } from '../content/types';

interface Props {
  site: Site;
}
const { site } = Astro.props;
---

<Section id="services" level={site.services.level} ghost="3" tone="dark">
  <h2 class="font-[family-name:var(--font-display)] text-3xl font-bold sm:text-4xl">
    {site.services.heading}
  </h2>
  <p class="mt-6 max-w-3xl text-lg leading-relaxed text-concrete-100">{site.services.intro}</p>

  <!-- Lifecycle timeline: vertical on mobile, 5 columns on desktop -->
  <ol class="mt-14 grid gap-10 lg:grid-cols-5 lg:gap-6">
    {site.services.items.map((s, i) => (
      <li class="relative border-s-2 border-concrete-700 ps-6 lg:border-s-0 lg:border-t-2 lg:ps-0 lg:pt-6">
        <span
          aria-hidden="true"
          class="absolute -start-[7px] top-0 size-3 bg-amber lg:start-0 lg:-top-[7px]"
        ></span>
        <p class="font-[family-name:var(--font-display)] text-sm font-semibold text-amber">
          {String(i + 1).padStart(2, '0')}
        </p>
        <h3 class="mt-2 font-[family-name:var(--font-display)] text-lg font-semibold">
          {s.title}
        </h3>
        <p class="mt-2 text-sm leading-relaxed text-concrete-300">{s.desc}</p>
      </li>
    ))}
  </ol>
</Section>
