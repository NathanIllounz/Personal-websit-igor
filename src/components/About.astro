---
import Section from './Section.astro';
import type { Site } from '../content/types';

interface Props {
  site: Site;
}
const { site } = Astro.props;
---

<Section id="about" level={site.about.level} ghost="1" tone="dark">
  <div class="grid gap-12 lg:grid-cols-[1fr_320px] lg:items-start">
    <div>
      <h2 class="font-[family-name:var(--font-display)] text-3xl font-bold text-balance sm:text-4xl">
        {site.about.heading}
      </h2>
      <div class="mt-8 space-y-5 text-lg leading-relaxed text-concrete-100">
        {site.about.paragraphs.map((p) => <p>{p}</p>)}
      </div>
    </div>

    <!-- Portrait placeholder (pseudo) — swap for a real photo (CONTENT-TODO.md) -->
    <figure class="mx-auto w-64 lg:w-full">
      <div class="border border-concrete-700 bg-concrete-700/30 p-2">
        <svg
          viewBox="0 0 240 300"
          role="img"
          aria-label={site.about.portraitAlt}
          class="block w-full"
        >
          <rect width="240" height="300" fill="none" />
          <g fill="none" stroke="var(--color-concrete-300)" stroke-width="2">
            <circle cx="120" cy="110" r="46" />
            <path d="M48 268 c0-56 32-86 72-86 s72 30 72 86" />
          </g>
          <g stroke="var(--color-concrete-700)" stroke-width="1">
            <line x1="16" y1="16" x2="40" y2="16" />
            <line x1="16" y1="16" x2="16" y2="40" />
            <line x1="224" y1="284" x2="200" y2="284" />
            <line x1="224" y1="284" x2="224" y2="260" />
          </g>
        </svg>
      </div>
      <figcaption class="mt-3 text-center text-xs tracking-widest text-concrete-500 uppercase">
        Igor Gabriielian
      </figcaption>
    </figure>
  </div>
</Section>
