---
import { Image } from 'astro:assets';
import Section from './Section.astro';
import type { Site } from '../content/types';
import portrait from '../assets/igor/igor-portrait.jpg';
import candid from '../assets/igor/igor-walk.jpg';

interface Props {
  site: Site;
}
const { site } = Astro.props;
---

<Section id="about" level={site.about.level} ghost="1" tone="dark">
  <div class="grid gap-12 lg:grid-cols-[1fr_320px] lg:items-start">
    <div>
      <h2 class="font-[family-name:var(--font-display)] text-3xl font-bold text-balance sm:text-4xl">
        {site.about.heading}
      </h2>
      <div class="mt-8 space-y-5 text-lg leading-relaxed text-concrete-100">
        {site.about.paragraphs.map((p) => <p>{p}</p>)}
      </div>
    </div>

    <figure class="mx-auto w-64 lg:w-full">
      <div class="border border-concrete-700 bg-concrete-700/30 p-2">
        <Image src={portrait} width={640} alt={site.about.portraitAlt} class="block w-full" />
      </div>
      <figcaption class="mt-3 text-center text-xs tracking-widest text-concrete-300 uppercase">
        Igor Gabriielian
      </figcaption>
    </figure>
  </div>

  <!-- Candid: walking the rails of a system under installation -->
  <figure class="mt-16 border border-concrete-700 p-2">
    <Image src={candid} width={1200} alt={site.about.candidAlt} class="block w-full" />
  </figure>
</Section>
