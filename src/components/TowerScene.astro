---
// "The Cutaway" — fixed 3D-style background scene of the parking tower.
// Drawn in the site's blueprint language (hairlines, isometric slabs, amber
// accents). scripts/scroll.ts drives the camera one floor down per section
// with a perspective dip; the active floor's light strip glows amber and the
// lift platform (#scene-lift) rides along. Desktop-only, reduced-motion-safe
// (hidden via CSS in global.css).
const FLOORS = [1, 2, 3, 4, 5];
const FLOOR_H = 520; // SVG units between slabs — scroll.ts mirrors this ratio
const W = 1600;
const H = FLOOR_H * 6 + 200;

// x-positions of parked-car pallets per side (shaft sits at x 1150–1370)
const PALLETS_LEFT = [120, 420, 720];
const PALLET_W = 240;
---

<div id="tower-viewport" aria-hidden="true">
  <svg
    id="tower-scene"
    viewBox={`0 0 ${W} ${H}`}
    width="100%"
    preserveAspectRatio="xMidYMin meet"
    fill="none"
  >
    <!-- lift shaft rails -->
    <g stroke="var(--color-concrete-700)" stroke-width="2">
      <line x1="1170" y1="0" x2="1170" y2={H} />
      <line x1="1350" y1="0" x2="1350" y2={H} />
      <line x1="1180" y1="0" x2="1180" y2={H} stroke-width="1" opacity="0.5" />
      <line x1="1340" y1="0" x2="1340" y2={H} stroke-width="1" opacity="0.5" />
    </g>

    {FLOORS.map((f) => {
      const y = f * FLOOR_H;
      return (
        <g data-floor={f} class="scene-floor">
          <!-- slab with isometric depth -->
          <g stroke="var(--color-concrete-700)" stroke-width="2">
            <line x1="0" y1={y} x2={W} y2={y} />
            <path d={`M0 ${y} L60 ${y - 34} L${W} ${y - 34}`} stroke-width="1" opacity="0.55" />
          </g>
          <!-- columns down to next slab -->
          <g stroke="var(--color-concrete-700)" stroke-width="1.5" opacity="0.6">
            <line x1="60" y1={y - 34} x2="60" y2={y + FLOOR_H - 34} />
            <line x1="1060" y1={y} x2="1060" y2={y + FLOOR_H} />
          </g>
          <!-- pallets with parked car silhouettes -->
          <g stroke="var(--color-concrete-500)" stroke-width="2">
            {PALLETS_LEFT.map((px) => (
              <g>
                <path d={`M${px} ${y - 8} h${PALLET_W} l24 -14 h-${PALLET_W}Z`} opacity="0.7" />
                <g
                  stroke="var(--color-concrete-300)"
                  stroke-width="4"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  opacity="0.75"
                  transform={`translate(${px + 30} ${y - 66}) scale(6.8)`}
                >
                  <path d="M1 7 V5.5 L3.5 5 L6 2.5 H12 L15 5 H19 V7 H17" />
                  <path d="M8.5 7 H11" />
                  <circle cx="6" cy="7.2" r="1.5" />
                  <circle cx="14" cy="7.2" r="1.5" />
                </g>
              </g>
            ))}
          </g>
          <!-- floor label + light strip -->
          <text
            x="80"
            y={y - FLOOR_H / 2}
            font-size="52"
            letter-spacing="8"
            fill="var(--color-concrete-700)"
            style="font-family: var(--font-display); font-weight: 700;"
          >
            {`L−${f}`}
          </text>
          <line class="floor-light" x1="0" y1={y - FLOOR_H + 40} x2="1060" y2={y - FLOOR_H + 40} stroke="var(--color-amber)" stroke-width="3" />
        </g>
      );
    })}

    <!-- lift platform: scroll.ts translates this to the active floor -->
    <g id="scene-lift">
      <g stroke="var(--color-amber)" stroke-width="3">
        <line x1="1180" y1="480" x2="1340" y2="480" />
      </g>
      <g
        stroke="var(--color-paper)"
        stroke-width="3.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        opacity="0.9"
        transform="translate(1196 428) scale(6.4)"
      >
        <path d="M1 7 V5.5 L3.5 5 L6 2.5 H12 L15 5 H19 V7 H17" />
        <path d="M8.5 7 H11" />
        <circle cx="6" cy="7.2" r="1.5" />
        <circle cx="14" cy="7.2" r="1.5" />
      </g>
      <g stroke="var(--color-concrete-500)" stroke-width="1.5" opacity="0.8">
        <line x1="1200" y1="480" x2="1200" y2="500" />
        <line x1="1320" y1="480" x2="1320" y2="500" />
      </g>
    </g>
  </svg>
</div>
