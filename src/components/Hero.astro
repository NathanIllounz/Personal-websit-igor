---
// STREET LEVEL — light tone (daylight, before the descent).
import type { Site } from '../content/types';

interface Props {
  site: Site;
}
const { site } = Astro.props;
---

<section id="top" class="relative overflow-hidden bg-paper px-6 pt-32 pb-20 text-ink sm:pt-40">
  <!-- blueprint grid texture -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 [background-image:linear-gradient(to_right,rgba(17,18,20,0.05)_1px,transparent_1px),linear-gradient(to_bottom,rgba(17,18,20,0.05)_1px,transparent_1px)] [background-size:56px_56px]"
  >
  </div>

  <div class="section-inner relative z-10 mx-auto max-w-5xl">
    <p class="mb-10 inline-flex items-center gap-3 border border-concrete-300 px-3 py-1 text-xs tracking-[0.3em] text-concrete-500 uppercase">
      <span class="inline-block size-1.5 bg-amber"></span>
      {site.hero.level}
    </p>

    <h1 class="font-[family-name:var(--font-display)] text-4xl font-bold tracking-[0.12em] text-balance sm:text-6xl">
      {site.hero.name}
    </h1>
    <p class="mt-6 max-w-2xl text-lg text-concrete-700 sm:text-2xl">{site.hero.title}</p>
    <p class="mt-4 font-[family-name:var(--font-display)] text-lg font-semibold">
      {site.hero.tagline}
    </p>
    <p class="mt-6 text-sm tracking-[0.25em] text-concrete-500 uppercase">{site.hero.services}</p>

    <a
      href="#contact"
      class="mt-10 inline-block bg-ink px-8 py-4 font-[family-name:var(--font-display)] text-sm font-semibold tracking-widest text-paper uppercase transition-colors hover:bg-amber hover:text-ink"
    >
      {site.hero.cta}
    </a>

    <dl class="mt-20 grid grid-cols-2 gap-px border border-concrete-300 bg-concrete-300 sm:grid-cols-3">
      {site.hero.stats.map((s) => (
        <div class="bg-paper p-6">
          <dt class="sr-only">{s.label}</dt>
          <dd data-countup class="font-[family-name:var(--font-display)] text-2xl font-bold sm:text-3xl">
            {s.value}
          </dd>
          <dd class="mt-2 text-sm text-concrete-500">{s.label}</dd>
        </div>
      ))}
    </dl>

    <p class="mt-16 flex items-center gap-3 text-xs tracking-[0.3em] text-concrete-500 uppercase">
      {site.hero.scrollHint}
      <span aria-hidden="true" class="animate-hint inline-block text-amber">↓</span>
    </p>
  </div>
</section>
