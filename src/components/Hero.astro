---
// STREET LEVEL — light tone (daylight, before the descent).
// Intro choreography + parallax live in scripts/scroll.ts; the lift-diagram
// loop is CSS (html.user-active gated, reduced-motion-safe).
import type { Site } from '../content/types';

interface Props {
  site: Site;
}
const { site } = Astro.props;
const words = site.hero.name.split(' ');

// Sleek sedan, side view, 26x13.5 box (custom-drawn — licensing-safe).
const CAR_BODY =
  'M1 11 V9.8 Q1 8.8 2.4 8.5 L5.3 8 Q7.7 5.4 11 5.1 Q14.9 4.8 17.3 6.5 L19.2 8 Q22.8 8.2 24.3 9 Q25 9.4 25 10.2 V11 H21.2';
const CAR_GLASS = 'M6.6 7.9 Q8.6 6 11.2 5.7 L14.7 5.7 Q16.1 6.4 17.3 7.7 M12.4 5.7 V7.9';
const CAR_SILLS = ['M1 11 H4.3', 'M8.7 11 H16.8'];
const CAR_WHEELS = [
  { cx: 6.5, cy: 11.1, r: 2 },
  { cx: 19, cy: 11.1, r: 2 },
];
---

<section id="top" class="relative overflow-hidden bg-paper px-6 pt-32 pb-20 text-ink sm:pt-40">
  <!-- blueprint grid texture (parallax layer) -->
  <div
    aria-hidden="true"
    class="hero-grid pointer-events-none absolute -inset-8 [background-image:linear-gradient(to_right,rgba(17,18,20,0.06)_1px,transparent_1px),linear-gradient(to_bottom,rgba(17,18,20,0.06)_1px,transparent_1px)] [background-size:56px_56px]"
  >
  </div>

  <!-- ghost level marking -->
  <span
    aria-hidden="true"
    class="pointer-events-none absolute -bottom-8 start-0 font-[family-name:var(--font-display)] text-[24vw] leading-none font-bold text-ink/4 select-none"
  >
    L0
  </span>

  <!-- diagonal amber beams -->
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 overflow-hidden">
    <div class="absolute -top-1/4 start-1/4 h-[150%] w-px rotate-[22deg] bg-gradient-to-b from-transparent via-amber/30 to-transparent"></div>
    <div class="absolute -top-1/4 start-2/3 h-[150%] w-px rotate-[22deg] bg-gradient-to-b from-transparent via-amber/20 to-transparent"></div>
  </div>

  <!-- pointer-following amber glow (vars set by scripts/scroll.ts) -->
  <div aria-hidden="true" class="hero-glow pointer-events-none absolute inset-0"></div>

  <!-- line-art APS rack with cycling lift (parallax layer, desktop only) -->
  <div
    aria-hidden="true"
    class="hero-diagram pointer-events-none absolute top-24 bottom-8 end-[-70px] w-[300px] opacity-25 xl:top-28 xl:end-[-40px] xl:w-[420px] xl:opacity-80"
  >
    <svg viewBox="0 0 460 560" fill="none" class="h-full w-full" preserveAspectRatio="xMidYMid meet">
      <!-- bay frame -->
      <g stroke="var(--color-concrete-300)" stroke-width="2">
        <line x1="20" y1="40" x2="20" y2="520" />
        <line x1="260" y1="40" x2="260" y2="520" />
        <line x1="20" y1="40" x2="260" y2="40" />
        <line x1="20" y1="200" x2="260" y2="200" />
        <line x1="20" y1="360" x2="260" y2="360" />
        <line x1="20" y1="520" x2="260" y2="520" />
      </g>
      <!-- shaft rails -->
      <g stroke="var(--color-concrete-300)" stroke-width="2">
        <line x1="300" y1="40" x2="300" y2="540" />
        <line x1="450" y1="40" x2="450" y2="540" />
      </g>
      <g stroke="var(--color-concrete-300)" stroke-width="1" opacity="0.7">
        {[80, 120, 160, 240, 280, 320, 400, 440, 480].map((y) => (
          <>
            <line x1="300" y1={y} x2="308" y2={y} />
            <line x1="442" y1={y} x2="450" y2={y} />
          </>
        ))}
      </g>
      <!-- amber level markers -->
      <g fill="var(--color-amber)">
        <rect x="264" y="196" width="10" height="4" />
        <rect x="264" y="356" width="10" height="4" />
        <rect x="264" y="516" width="10" height="4" />
      </g>
      <!-- parked cars (levels 1 and 3) -->
      {[92, 412].map((ty) => (
        <g
          stroke="var(--color-concrete-500)"
          stroke-width="1.4"
          stroke-linecap="round"
          stroke-linejoin="round"
          transform={`translate(26 ${ty}) scale(8)`}
        >
          <path d={CAR_BODY} />
          <path d={CAR_GLASS} />
          {CAR_SILLS.map((d) => (
            <path d={d} />
          ))}
          {CAR_WHEELS.map((w) => (
            <>
              <circle cx={w.cx} cy={w.cy} r={w.r} />
              <circle cx={w.cx} cy={w.cy} r={w.r * 0.45} opacity="0.6" />
            </>
          ))}
        </g>
      ))}
      <!-- the lift: platform + car, cycles between levels (CSS keyframes) -->
      <g class="hero-lift">
        <line x1="302" y1="520" x2="448" y2="520" stroke="var(--color-amber)" stroke-width="4" />
        <g
          stroke="var(--color-concrete-700)"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          transform="translate(304 445) scale(5.5)"
        >
          <path d={CAR_BODY} />
          <path d={CAR_GLASS} />
          {CAR_SILLS.map((d) => (
            <path d={d} />
          ))}
          {CAR_WHEELS.map((w) => (
            <>
              <circle cx={w.cx} cy={w.cy} r={w.r} />
              <circle cx={w.cx} cy={w.cy} r={w.r * 0.45} opacity="0.6" />
            </>
          ))}
        </g>
      </g>
    </svg>
  </div>

  <div class="section-inner relative z-10 mx-auto max-w-5xl">
    <p
      data-intro
      class="mb-10 inline-flex items-center gap-3 border border-concrete-300 px-4 py-1.5 text-sm tracking-[0.3em] text-concrete-500 uppercase"
    >
      <span class="inline-block size-2 bg-amber"></span>
      {site.hero.level}
    </p>

    <h1 class="overflow-hidden font-[family-name:var(--font-display)] text-3xl font-bold tracking-[0.12em] text-balance sm:text-6xl">
      {words.map((word, wi) => (
        <>
          {wi > 0 && <span class="inline-block w-[0.35em]">&nbsp;</span>}
          <span class="inline-block whitespace-nowrap">
            {word.split('').map((ch) => (
              <span class="hero-letter inline-block will-change-transform">{ch}</span>
            ))}
          </span>
        </>
      ))}
    </h1>
    <p data-intro class="mt-6 max-w-2xl text-lg text-concrete-700 sm:text-2xl">{site.hero.title}</p>
    <p data-intro class="mt-4 font-[family-name:var(--font-display)] text-lg font-semibold">
      {site.hero.tagline}
    </p>
    <p data-intro class="mt-6 text-sm tracking-[0.25em] text-concrete-500 uppercase">
      {site.hero.services}
    </p>

    <a
      data-intro
      href="#contact"
      class="group mt-10 inline-flex items-center gap-3 bg-ink px-8 py-4 font-[family-name:var(--font-display)] text-sm font-semibold tracking-widest text-paper uppercase transition-colors duration-300 hover:bg-amber hover:text-ink"
    >
      {site.hero.cta}
      <span aria-hidden="true" class="inline-block transition-transform duration-300 group-hover:translate-y-0.5">↓</span>
    </a>

    <!-- animated as ONE unit: hiding individual tiles exposed the gray gap-grid -->
    <dl data-intro class="mt-20 grid grid-cols-2 gap-px border border-concrete-300 bg-concrete-300 sm:grid-cols-3">
      {site.hero.stats.map((s) => (
        <div class="stat-tile bg-paper p-6 transition-[transform,box-shadow] duration-300 hover:-translate-y-1 hover:shadow-[inset_0_-2px_0_0_var(--color-amber)]">
          <dt class="sr-only">{s.label}</dt>
          <dd data-countup class="font-[family-name:var(--font-display)] text-2xl font-bold sm:text-3xl">
            {s.value}
          </dd>
          <dd class="mt-2 text-sm text-concrete-500">{s.label}</dd>
        </div>
      ))}
    </dl>

    <p data-intro class="mt-16 flex items-center gap-3 text-xs tracking-[0.3em] text-concrete-500 uppercase">
      {site.hero.scrollHint}
      <span aria-hidden="true" class="inline-block text-amber">↓</span>
    </p>
  </div>
</section>
