---
import Section from './Section.astro';
import type { Site } from '../content/types';

interface Props {
  site: Site;
}
const { site } = Astro.props;
---

<Section id="why" level={site.why.level} ghost="4" tone="dark">
  <h2 class="font-[family-name:var(--font-display)] text-3xl font-bold text-balance sm:text-4xl">
    {site.why.heading}
  </h2>
  <p class="mt-6 font-[family-name:var(--font-display)] text-xl font-semibold text-amber sm:text-2xl">
    {site.why.hook}
  </p>
  <div class="mt-6 max-w-3xl space-y-5 text-lg leading-relaxed text-concrete-100">
    {site.why.intro.map((p) => <p>{p}</p>)}
  </div>

  <h3 class="mt-16 text-sm font-semibold tracking-[0.25em] text-concrete-300 uppercase">
    {site.why.reasonsTitle}
  </h3>
  <ol class="mt-8 space-y-10">
    {site.why.reasons.map((r, i) => (
      <li class="grid gap-4 border-t border-concrete-700 pt-8 sm:grid-cols-[100px_1fr]">
        <p class="font-[family-name:var(--font-display)] text-3xl font-bold text-amber">
          {String(i + 1).padStart(2, '0')}
        </p>
        <div>
          <h4 class="font-[family-name:var(--font-display)] text-xl font-semibold">{r.title}</h4>
          <div class="mt-3 space-y-3 leading-relaxed text-concrete-300">
            {r.body.map((p) => <p>{p}</p>)}
            {i === 3 && (
              <p class="pt-1 text-sm tracking-[0.2em] text-concrete-100 uppercase">
                {site.why.disciplines}
              </p>
            )}
          </div>
        </div>
      </li>
    ))}
  </ol>

  <div class="mt-20 border border-amber/50 p-8 sm:p-12">
    <p class="text-sm tracking-[0.25em] text-concrete-300 uppercase">{site.why.principleLabel}</p>
    <p class="mt-5 font-[family-name:var(--font-display)] text-2xl font-bold text-balance sm:text-3xl">
      {site.why.principle[0]}
      <br />
      <span class="text-amber">{site.why.principle[1]}</span>
    </p>
    <p class="mt-6 max-w-3xl leading-relaxed text-concrete-300">{site.why.closing}</p>
  </div>
</Section>
