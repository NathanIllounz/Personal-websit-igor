---
// Shared section shell: level label + ghost level number + tone (light/dark).
interface Props {
  id: string;
  level: string;
  ghost: string;
  tone?: 'light' | 'dark';
}
const { id, level, ghost, tone = 'dark' } = Astro.props;
const tones = {
  // dark sections are transparent: the fixed Cutaway scene (body is ink)
  // shows through behind the content on desktop
  dark: 'text-paper',
  light: 'bg-paper text-ink',
};
const ghostTone = tone === 'dark' ? 'text-paper/4' : 'text-ink/5';
const labelTone = tone === 'dark' ? 'text-concrete-300 border-concrete-700' : 'text-concrete-500 border-concrete-300';
---

<section id={id} class={`relative overflow-hidden px-6 py-24 sm:py-32 ${tones[tone]}`}>
  <span
    aria-hidden="true"
    data-ghost
    class={`pointer-events-none absolute top-1/2 -translate-y-1/2 end-0 select-none font-[family-name:var(--font-display)] text-[38vw] leading-none font-bold ${ghostTone}`}
  >
    {ghost}
  </span>

  <div class="section-inner relative z-10 mx-auto max-w-5xl">
    <p class={`mb-10 inline-flex items-center gap-3 border px-4 py-1.5 text-sm tracking-[0.3em] uppercase ${labelTone}`}>
      <span class="inline-block size-2 bg-amber"></span>
      {level}
    </p>
    <slot />
  </div>
</section>
