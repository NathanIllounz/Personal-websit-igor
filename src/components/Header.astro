---
import { Image } from 'astro:assets';
import type { Site } from '../content/types';
import logoMark from '../assets/logo-mark-dark.png';

interface Props {
  site: Site;
}
const { site } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const langHref = site.locale === 'en' ? `${base}/he/` : `${base}/`;
const links = [
  { href: '#about', label: site.nav.about },
  { href: '#manufacturers', label: site.nav.manufacturers },
  { href: '#services', label: site.nav.services },
  { href: '#why', label: site.nav.why },
  { href: '#projects', label: site.nav.projects },
  { href: '#contact', label: site.nav.contact },
];
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-paper/10 bg-ink/85 text-paper backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-6 py-3">
    <a href="#top" class="flex items-center">
      <Image src={logoMark} alt="" width={50} height={40} class="h-10 w-auto" />
      <span class="sr-only">Igor Gabriielian</span>
    </a>
    <nav class="hidden items-center gap-6 lg:flex" aria-label="Main">
      {links.map((l) => (
        <a href={l.href} class="text-sm text-concrete-300 transition-colors hover:text-amber">
          {l.label}
        </a>
      ))}
    </nav>
    <a
      href={langHref}
      class="border border-concrete-500 px-3 py-1 text-xs tracking-widest text-concrete-300 transition-colors hover:border-amber hover:text-amber"
    >
      {site.nav.langLabel}
    </a>
  </div>
</header>
