---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import LevelIndicator from '../components/LevelIndicator.astro';
import TowerScene from '../components/TowerScene.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Manufacturers from '../components/Manufacturers.astro';
import Services from '../components/Services.astro';
import Why from '../components/Why.astro';
import Projects from '../components/Projects.astro';
import Contact from '../components/Contact.astro';
import { site } from '../content/site.en';
---

<Base
  locale={site.locale}
  dir={site.dir}
  title={site.meta.title}
  description={site.meta.description}
  skipLabel={site.ui.skipToContent}
>
  <TowerScene />
  <Header site={site} />
  <LevelIndicator site={site} />
  <main id="main">
    <Hero site={site} />
    <About site={site} />
    <Manufacturers site={site} />
    <Services site={site} />
    <Why site={site} />
    <Projects site={site} />
    <Contact site={site} />
  </main>
</Base>
